                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const body = $json.body || {};\nconst message = String(body.message || \u0027\u0027).trim() || \u0027Hello\u0027;\n\nreturn [\n  {\n    json: {\n      openai_payload: {\n        model: \u0027gpt-5-mini\u0027,\n        instructions: [\n          \u0027You are AI Blog Assistant for a Laravel blog website.\u0027,\n          \u0027Answer in the same language as the visitor when possible.\u0027,\n          \u0027Keep replies short, friendly, and practical.\u0027,\n          \u0027If the visitor asks for exact site content you do not have, suggest checking the blog search or contact page.\u0027\n        ].join(\u0027 \u0027),\n        input: [\n          {\n            role: \u0027user\u0027,\n            content: \u0027Page URL: \u0027 + (body.page_url || \u0027unknown\u0027) + \u0027\\nChat ID: \u0027 + (body.chat_id || \u0027anonymous\u0027) + \u0027\\n\\nVisitor message: \u0027 + message\n          }\n        ],\n        max_output_tokens: 350\n      }\n    }\n  }\n];"
                                     },
                      "id":  "5304e0d8-f850-4a2b-91dc-bb22a90bd553",
                      "name":  "Prepare OpenAI Request",
